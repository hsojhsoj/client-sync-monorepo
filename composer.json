{
    "name": "dependentmedia/client-sync-monorepo",
    "description": "Client Sync — appointment booking, calendar sync, and availability management for WordPress (Free + Pro).",
    "license": "proprietary",
    "type": "wordpress-plugin",
    "require": {
        "google/apiclient": "^2.15",
        "twilio/sdk": "^8.8",
        "dompdf/dompdf": "^2.0",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "test": "export PATH=/opt/plesk/php/8.3/bin:$PATH && vendor/bin/phpunit --colors=always",
        "install-wp-tests": "bash bin/install-wp-tests.sh client-sync-monorepo test-cs-monorepo 'Ie7Fi1Na^kdkfa9*' localhost latest"
    },
    "autoload": {
        "files": [
            "src/shared/includes/autoloader.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}