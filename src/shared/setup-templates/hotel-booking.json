[
  {
    "template_meta": {
      "title": "Hotel Booking",
      "description": "A setup for hotels or motels where customers book a 'Room Type' rather than a specific room number. This template uses the 'Capacity' feature to manage the number of available rooms for each type (12 Queen, 6 King, 2 Suites = 20 total rooms). NOTE: After installing, create a corresponding WooCommerce product for each of the 3 room types to enable payments.",
      "recommended": false
    },
    "options": {
      "clisyc_dimension_registry": {
        "dimensions": {
          "clisyc_room_type": {
            "enabled": true,
            "primary": true,
            "frontend_visible": true
          }
        },
        "relationships": {},
        "filter_order": [
          "clisyc_room_type"
        ]
      },
      "clisyc_custom_dimension_types": {
        "clisyc_room_type": {
          "singular": "Room Type",
          "plural": "Room Types",
          "icon": "dashicons-building",
          "public": true
        }
      }
    },
    "cpts": {
      "clisyc_room_type": [
        {
