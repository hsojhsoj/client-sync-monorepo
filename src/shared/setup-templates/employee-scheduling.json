        "dimensions": {
          "clisyc_service": {
            "enabled": true,
            "primary": true,
            "frontend_visible": true,
            "is_resource": false
          },
          "clisyc_employee": {
            "enabled": true,
            "primary": false,
            "frontend_visible": true,
            "is_resource": true
          }
        },
        "relationships": {},
